# Copy to .env and adjust. Every value below is the default used by config.py.
SEED=42
STREAM_RATE=50

# Host ports published by docker-compose. If you change one, change the matching
# KAFKA_BOOTSTRAP_SERVERS / REDIS_PORT / POSTGRES_PORT value too.
KAFKA_PORT=9092
KAFKA_HEAP_MB=384
KAFKA_TRANSACTIONS_PARTITIONS=3
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTIONS_TOPIC=transactions
KAFKA_ALERTS_TOPIC=alerts
KAFKA_CONSUMER_GROUP=payguard-consumer
CONSUMER_BATCH_SIZE=200

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
STATE_TTL_DAYS=90

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=payguard
POSTGRES_USER=payguard
POSTGRES_PASSWORD=payguard

COST_MISSED_FRAUD=200
COST_BLOCKED_LEGIT=5
BLOCK_MIN_PRECISION=0.95

API_HOST=127.0.0.1
API_PORT=8010
